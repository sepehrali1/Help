-- پوسته
local skins = {
 {"قرمز", Color3.fromRGB(220, 60, 60)},
 {"آبی", Color3.fromRGB(60, 130, 255)},
 {"سبز", Color3.fromRGB(60, 200, 90)},
 {"بنفش", Color3.fromRGB(160, 80, 220)}
}

local skinIndex = 0
local skin = makeButton("🎨 پوسته", 406)

skin.MouseButton1Click:Connect(function()
 skinIndex += 1

 if skinIndex > #skins then
  skinIndex = 1
 end

 skin.BackgroundColor3 = YELLOW

 local char = player.Character

 if char then
  for _, part in ipairs(char:GetChildren()) do
   if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
    part.Color = skins[skinIndex][2]
   end
  end
 end

 skin.Text = "🎨 " .. skins[skinIndex][1]

 task.wait(0.4)

 skin.BackgroundColor3 = GREEN
end)

